      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(sum(horas_sin_red), 0) AS horas_sin_red FROM gold.vw_horas_sin_red_dia WHERE inverter_key IN (${inversor:csv}) AND $__timeFilter(fecha)"
