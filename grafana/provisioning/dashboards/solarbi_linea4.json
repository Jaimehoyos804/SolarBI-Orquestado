    {
      "id": 3,
      "type": "table",
      "title": "Último dato por inversor (linepowerw_a)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "solarbi-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT i.nombre AS \"Inversor\", f.hour_local AS \"Última hora con datos\", round(f.positive_power_unit_hours, 1) AS \"Importada en esa hora\", round(f.cobertura_pct, 0) AS \"Cobertura %\" FROM (SELECT DISTINCT ON (inverter_key) * FROM gold.fact_energia_red_hora WHERE variable_key = 'linepowerw_a' ORDER BY inverter_key, hour_local DESC) f JOIN gold.dim_inversor i USING (inverter_key) WHERE f.inverter_key IN (${inversor:csv}) ORDER BY 1"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
