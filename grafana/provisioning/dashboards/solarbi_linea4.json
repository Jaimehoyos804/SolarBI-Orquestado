      "title": "Horas sin red (eventos)",
      "description": "Suma de eventos grid_unavailable_or_islanded (derivados de las mismas mediciones; no es una fuente independiente).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "solarbi-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
