table 'Balance componentes'
	isHidden
	lineageTag: d16680fe-8408-4914-b7f4-69e74bfe077e

	measure 'Balance kWh' =
			
			SWITCH(SELECTEDVALUE('Balance componentes'[Componente]),
			    "Solar", [Solar kWh],
			    "Red", [Red kWh],
			    "Batería (descarga)", [Batería descarga kWh],
			    "Carga atendida", [Carga kWh],
			    "Batería (carga)", [Batería carga kWh],
			    "No explicado", [No explicado kWh])
		isHidden
		lineageTag: d155b5a0-779e-4f39-9f13-1a242e4bd698

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Costo red (escenario)' = [Red kWh] * SELECTEDVALUE('Tarifa'[Tarifa], 0.8)
		lineageTag: 3488c7e8-2239-4d29-8b91-2737dbac98fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Componente
		isHidden
		lineageTag: c6cfa17c-06e9-4be2-b314-d0f860081f5c
		summarizeBy: none
		isNameInferred
		sourceColumn: [Componente]
		sortByColumn: Orden

		annotation SummarizationSetBy = Automatic

	column Orden
		isHidden
		formatString: 0
		lineageTag: 989ceaa4-9577-4bad-8a96-f76e7fa4b41e
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Orden]

		annotation SummarizationSetBy = Automatic

	column Tipo
		isHidden
		lineageTag: f2b0227a-badc-4a2f-b14c-42fc2e738058
		summarizeBy: none
		isNameInferred
		sourceColumn: [Tipo]

		annotation SummarizationSetBy = Automatic

	partition 'Balance componentes' = calculated
		mode: import
		source =
				
				DATATABLE("Componente", STRING, "Orden", INTEGER, "Tipo", STRING,
				    {
				        {"Solar", 1, "Entra"},
				        {"Red", 2, "Entra"},
				        {"Batería (descarga)", 3, "Entra"},
				        {"Carga atendida", 4, "Sale"},
				        {"Batería (carga)", 5, "Sale"},
				        {"No explicado", 6, "Residuo"}
				    })

	annotation PBI_Id = 9a6ee0b7683c4c10bea2f3d327b9bdda

