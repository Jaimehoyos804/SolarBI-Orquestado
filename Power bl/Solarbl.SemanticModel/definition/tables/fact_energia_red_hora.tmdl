table fact_energia_red_hora
	lineageTag: 975d7a57-dfab-40d8-8f0c-f6931683d851

	measure 'Solar kWh' = ```
			
			      CALCULATE(SUM(fact_energia_red_hora[positive_power_unit_hours]), dim_variable[variable_key] = "pv1power") / 1000
			```
		lineageTag: 5691ad5a-6c4d-402b-b93e-535cece6d56d

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Red kWh' = ```
			
			      CALCULATE(SUM(fact_energia_red_hora[positive_power_unit_hours]), dim_variable[variable_key] = "linepowerw_a") / 1000
			```
		lineageTag: bda4523c-b5ad-4be6-b367-5f812e119889

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Carga kWh' = ```
			
			      CALCULATE(SUM(fact_energia_red_hora[positive_power_unit_hours]), dim_variable[variable_key] = "outw_a") / 1000
			```
		lineageTag: 199f44a1-dcd3-493a-9e3f-c3f71135dd09

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Batería descarga kWh' = ```
			
			      CALCULATE(SUM(fact_energia_red_hora[positive_power_unit_hours]), dim_variable[variable_key] = "battpower_calc") / 1000
			```
		lineageTag: 2281d215-8feb-4d9d-a274-03a4e09b2ac4

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Batería carga kWh' = ```
			
			      CALCULATE(SUM(fact_energia_red_hora[negative_power_unit_hours]), dim_variable[variable_key] = "battpower_calc") / 1000
			```
		lineageTag: ae42e098-edbe-4ec9-9e0e-6bf1cf7e5d77

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Entradas kWh' = [Solar kWh] + [Red kWh] + [Batería descarga kWh]
		lineageTag: 9cd7a855-9540-4924-ac3d-8c940f92b6e4

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salidas kWh' = [Carga kWh] + [Batería carga kWh]
		lineageTag: a6bf4f3c-5649-4724-ab58-cf9454646eb7

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'No explicado kWh' = [Entradas kWh] - [Salidas kWh]
		lineageTag: ff9ba3e6-f117-4494-bf66-af2982bbb41f

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'No explicado %' = DIVIDE([No explicado kWh], [Entradas kWh])
		lineageTag: f515264a-b49e-448b-a187-57b0b89b6926

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% red' = DIVIDE([Red kWh], [Entradas kWh])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8d547dd1-f653-4085-bfdb-ac7c8fa5be33

		changedProperty = IsHidden

	measure 'Red kWh mes anterior' =
			
			CALCULATE(
			    [Red kWh],
			    REMOVEFILTERS('dim_fecha'),
			    DATEADD('dim_fecha'[fecha], -1, MONTH)
			)
		lineageTag: 4d814193-2097-4bea-9629-a1e821f661ff

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var % red vs mes anterior' = ```
			
			      DIVIDE([Red kWh] - [Red kWh mes anterior], [Red kWh mes anterior])
			```
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 331c08f8-ab7a-482a-a7e6-8d76909564b0

		changedProperty = IsHidden

	measure 'Disponibilidad del registro %' = ```
			
			      CALCULATE(AVERAGE(fact_energia_red_hora[cobertura_pct]), dim_variable[variable_key] = "linepowerw_a")
			```
		lineageTag: 2d68e51f-40a5-48d4-a084-4231cfd2c5ea

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

