# --- PostgreSQL ---
# Host y puerto que usan los scripts de Python y DBeaver desde su equipo.
# Dentro de Docker Compose y Kubernetes se reemplazan por postgres:5432.
DB_HOST=localhost
DB_PORT=xxx
DB_NAME=solarbi
DB_USER=solarbi
DB_PASSWORD=xxxx

# --- Grafana ---
# Usuario "admin"
GRAFANA_ADMIN_PASSWORD=xxx
# Puerto de Grafana en su equipo con Docker Compose (en Kubernetes es el 30300).
GRAFANA_PORT=3002

